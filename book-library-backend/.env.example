# Server (default: 3000)
PORT=3000

# JWT
JWT_SECRET=your-secret-change-in-production
JWT_EXPIRES_IN=7d

# Database - ถ้าไม่มี .env ก็ใช้ค่า default เหล่านี้
# DB_HOST ว่างหรือไม่ตั้ง = ใช้ SQLite (./data/library.db)
# DB_HOST มีค่า = ใช้ PostgreSQL
DB_HOST=
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=library
